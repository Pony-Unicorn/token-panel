{
  "name": "token-panel",
  "compatibility_date": "2026-02-22",
  "main": "worker.js",
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    {
      "pattern": "tpp.testbug.cc",
      "custom_domain": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "8ad1e2a3f7c3432b9057e391ea727af2"
    }
  ],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
