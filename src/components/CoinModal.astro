---
// src/components/CoinModal.astro
---

<dialog x-ref="coinModal" class="modal" aria-labelledby="coin-modal-title">
  <div class="modal-box">
    <h3 id="coin-modal-title" class="text-lg font-bold mb-4">
      添加代币
    </h3>
    <form @submit.prevent="searchCoins()" class="flex gap-2">
      <input
        type="text"
        class="input flex-1"
        placeholder="搜索代币名称或符号"
        x-model="coinModal.query"
        autofocus
      />
      <button type="submit" class="btn btn-primary" :disabled="coinModal.isSearching">
        <span
          x-show="coinModal.isSearching"
          class="loading loading-spinner loading-sm"
          x-cloak
        ></span>
        <span x-show="!coinModal.isSearching">搜索</span>
      </button>
    </form>

    <!-- Search error -->
    <template x-if="coinModal.searchError">
      <p class="text-sm text-error/70 mt-2" x-text="coinModal.searchError"></p>
    </template>

    <!-- Results -->
    <div class="mt-3 flex flex-col gap-0.5 max-h-64 overflow-y-auto" role="list">
      <template x-for="result in coinModal.results" :key="result.id">
        <button
          type="button"
          class="flex items-center gap-3 px-2 py-2 rounded-lg hover:bg-base-200 transition-colors text-left w-full cursor-pointer"
          :disabled="isSaving"
          @click="selectCoin(result.id)"
          role="listitem"
        >
          <img
            :src="result.thumb"
            :alt="result.name"
            class="size-7 rounded-full shrink-0"
          />
          <span class="text-sm font-semibold truncate" x-text="result.name"></span>
          <span class="text-xs text-base-content/40 shrink-0" x-text="result.symbol"></span>
          <span
            class="text-xs text-base-content/30 ml-auto shrink-0 font-mono tabular-nums"
            x-text="result.market_cap_rank ? '#' + result.market_cap_rank : ''"
          ></span>
          <span
            x-show="isSaving"
            class="loading loading-spinner loading-xs shrink-0"
            x-cloak
          ></span>
        </button>
      </template>
    </div>

    <div class="modal-action">
      <button type="button" class="btn btn-ghost" @click="$refs.coinModal.close()">
        取消
      </button>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>
