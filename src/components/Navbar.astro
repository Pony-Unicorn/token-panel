---
import pkg from '../../package.json'
// Navbar component for Token Panel
---

<header class="navbar bg-base-100 shadow-sm px-4 sm:px-6 sticky top-0 z-30">
  <div class="flex-1 flex items-center gap-2 sm:gap-3">
    <a href="/" class="flex items-center gap-2">
      <img src="/logo.png" alt="Token Panel" class="h-8 w-auto object-contain" />
      <span class="badge badge-neutral badge-xs font-mono text-[10px] opacity-60">
        v{pkg.version}
      </span>
    </a>
    <div
      x-show="lastUpdatedText"
      class="flex items-center gap-1 text-xs text-base-content/40"
      x-cloak
    >
      <span x-text="lastUpdatedText"></span>
      <button
        type="button"
        class="btn btn-ghost btn-xs btn-circle size-6 min-h-0 p-0 text-base-content/50 hover:text-base-content"
        :disabled="isRefreshing"
        @click="refreshAll()"
        title="强制刷新所有价格"
        aria-label="强制刷新所有价格"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-3.5"
          :class="{ 'animate-spin': isRefreshing }"
          aria-hidden="true"
        >
          <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
          <path d="M3 3v5h5"></path>
          <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"></path>
          <path d="M16 21h5v-5"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="flex-none gap-2 flex items-center">
    <!-- Price error indicator -->
    <div x-show="priceError" class="tooltip tooltip-bottom" :data-tip="priceError" x-cloak>
      <button
        class="btn btn-sm btn-ghost text-warning"
        @click="refreshAll()"
        aria-label="价格加载失败，点击重试"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="w-4 h-4"
          aria-hidden="true"
        >
          <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
          <path d="M12 9v4"></path>
          <path d="M12 17h.01"></path>
        </svg>
      </button>
    </div>

    <!-- Edit mode toggle -->
    <button
      class="btn btn-sm"
      :class="isEditMode ? 'btn-success' : 'btn-ghost'"
      @click="toggleEditMode()"
    >
      <!-- 编辑图标 -->
      <svg
        x-show="!isEditMode"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="w-4 h-4"
        aria-hidden="true"
      >
        <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"></path>
        <path d="m15 5 4 4"></path>
      </svg>
      <!-- 完成图标 -->
      <svg
        x-show="isEditMode"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="w-4 h-4"
        aria-hidden="true"
        x-cloak
      >
        <path d="M20 6 9 17l-5-5"></path>
      </svg>
      <span x-text="isEditMode ? '完成' : '编辑'"></span>
    </button>
  </div>
</header>
